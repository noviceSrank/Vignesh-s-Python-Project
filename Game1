# Rock paper scissor game :) 
player1_points = 0
player2_points = 0

def game(player1, player2):
    valid_choices = ["scissor", "paper", "rock"]

    if player1 not in valid_choices or player2 not in valid_choices:
        return "invalid"

    if player1 == player2:
        return "draw"

    if (player1 == "scissor" and player2 == "paper") or \
       (player1 == "paper" and player2 == "rock") or \
       (player1 == "rock" and player2 == "scissor"):
        return "player1"
    else:
        return "player2"


while True:
    player1 = input("Player 1, enter your option: ").lower()

    if player1 not in ["scissor", "paper", "rock"]:
        print("Invalid choice, try again.")
        continue

    player2 = input("Player 2, enter your option: ").lower()

    result = game(player1, player2)

    if result == "invalid":
        print("Invalid choice, try again.")
        continue

    if result == "draw":
        print("It's a draw!")
    elif result == "player1":
        player1_points += 1
        print("Player 1 wins this round!")
    else:
        player2_points += 1
        print("Player 2 wins this round!")

    print(f"Score → Player 1: {player1_points} | Player 2: {player2_points}")

    # Check if someone reached 3 points
    if player1_points == 3:
        print("🎉 Player 1 wins the game!")
        
    if player2_points == 3:
        print("🎉 Player 2 wins the game!")
        
